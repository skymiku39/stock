# === 執行模式 ===
# trade  = 完整自動交易 (需 API key + CA 憑證)
# watch  = 看盤模式 (需 API key 接行情，不啟用 CA、不送單)
# report = 報表模式 (不需 API key，使用 TWSE 公開延遲資料)
RUN_MODE=trade

# 行情來源 (留空自動判斷: trade/watch → shioaji, report → twse_public)
# MARKET_SOURCE=shioaji

# broker backend (目前正式主流程仍以 shioaji 為主；t4 為 DLL 下單 adapter 測試骨架)
BROKER_BACKEND=shioaji

# 公開延遲資料輪詢間隔 (秒，僅 report 模式)
REPORT_POLL_SECONDS=5

# 報表輸出目錄
REPORT_OUTPUT_DIR=data/reports

# === Shioaji 登入資訊 (trade/watch 模式必填) ===
API_KEY=YOUR_API_KEY
SECRET_KEY=YOUR_SECRET_KEY

# === T4 DLL 下單元件 (Windows-only；先用於 adapter 對齊/測試) ===
# 驗證：
#   uv run stock-t4-validate
#   uv run stock-t4-validate --exam1st      # 會留下官方首次測試紀錄
#   uv run stock-t4-validate --order-test   # 會送出真實 T4 stock_order2 測試單
T4_DLL_PATH=D:/skymiku/stock/docs/T4_10142/VBA/t4x64.dll
T4_DLL_DIR=D:/skymiku/stock/docs/T4_10142/VBA
T4_LOGIN_ID=
T4_LOGIN_PASSWORD=
T4_PERSON_ID=
T4_CA_PATH=
T4_CA_PASSWORD=
T4_STOCK_BRANCH=
T4_STOCK_ACCOUNT=

# === 電子憑證 (trade 模式實單必填) ===
CA_PATH=C:/path/to/Sinopac.pfx
CA_PASSWORD=your_ca_password
PERSON_ID=YOUR_PERSON_ID

# === 模擬模式 (true = 不會真的下單，僅 trade 模式有效) ===
SIMULATION=true

# === 監控股票列表 (逗號分隔) ===
SYMBOLS=2330,0050

# === 策略時間 (HH:MM) ===
ENTER_CUTOFF_TIME=09:30
EXIT_TIME=13:15

# === 停損停利 (百分比) ===
STOP_LOSS_PCT=-3.0
TAKE_PROFIT_PCT=6.0
TRAILING_STOP_PCT=2.0
# 每檔使用者指定賣出門檻；例 2330 報酬率達 +8%、0050 達 +5.5% 才允許 AI 自動賣。
# 有設定的股票會優先照此門檻直接賣出，且未達門檻時不會被停損/移動停利/收盤全出自動賣掉。
# 空白 = 該檔沿用原本 STOP_LOSS/TAKE_PROFIT/TRAILING_STOP 邏輯。
SELL_PROFIT_TARGETS=

# === 資金控管 ===
MAX_FUND=500000
MAX_LOT_PER_SYMBOL=2

# === Telegram 通知 (留空則不啟用) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Gemini LLM 分析 ===
# 到 Google AI Studio 取得 API key: https://aistudio.google.com
# 測試流程：uv run stock-gemini-test
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# === 背景排程器 (stock-scheduler) ===
# 讓資料更新 + 盤中監測「持續自動執行」，不必開著儀表板。
#   uv run stock-scheduler            # 常駐 (Ctrl+C 結束)
#   uv run stock-scheduler --once     # 跑一輪即結束 (可搭配 Windows 工作排程器)
#   uv run stock-scheduler --dry-run  # 只印計畫不執行
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=30
# 輕量行情/總經刷新間隔 (分鐘，不打 LLM，成本低)；<=0 停用
SCHEDULER_MACRO_INTERVAL_MIN=30
SCHEDULER_FUNDAMENTALS_INTERVAL_MIN=360
SCHEDULER_FUNDAMENTALS_ARGS=--limit 3 --stale-days 30 --delay-seconds 30
# 完整研究管線間隔 (分鐘，含 ETF/籌碼/基本面 + LLM 簡報，較耗時/費用)；<=0 停用
SCHEDULER_RESEARCH_INTERVAL_MIN=240
# 傳給 stock-auto-research 的額外參數 (例如 "--no-brief" 省 LLM 成本)
SCHEDULER_RESEARCH_ARGS=
# 公司基本資料 (名稱/產業/上市日) 補齊間隔 (分鐘)；靜態資料預設一天一次；<=0 停用
SCHEDULER_COMPANY_INTERVAL_MIN=1440
# true = 資料刷新只在台股交易時段 (08:30-14:30) 與平日執行
SCHEDULER_MARKET_HOURS_ONLY=true
SCHEDULER_RUN_ON_START=true
# 盤中自動托管 stock-bot 監測子行程 (開盤啟動、收盤停止)
SCHEDULER_SUPERVISE_MONITOR=false
SCHEDULER_MONITOR_MODE=watch

# === 本地股票資料庫 (SQLite) ===
# 留空 = 預設 data/stock.db
# 若想用「Google 雲端硬碟同步」單機共用，把它指到 Drive 同步資料夾：
#   STOCK_DB_PATH=G:/My Drive/stock-shared/stock.db
STOCK_DB_PATH=

# === 雲端同步 (Google Sheets，多機共用 / Forms 寫入) ===
# 1. 在 Google Cloud Console 建立 service account 並啟用 Sheets + Drive API
# 2. 下載 SA 金鑰 JSON 並把路徑填到 GOOGLE_SA_JSON_PATH
# 3. 開一張 Google Sheet，把 SA 的 email 加為「編輯者」
# 4. 把 Sheet URL 中 /d/ 後的隨機 ID 填到 GOOGLE_SHEET_ID
# 詳細步驟請見 docs/cloud_sync_setup.md
GOOGLE_SHEET_ID=
GOOGLE_SA_JSON_PATH=

# Optional: Google Drive Desktop/shared folder used as a cross-machine cache.
# The app mirrors fetched files under data/ here, and another machine restores
# them before hitting TWSE/MOPS/yfinance/Gemini again.
# Example: G:/My Drive/stock-cloud-cache
GOOGLE_CACHE_DIR=
