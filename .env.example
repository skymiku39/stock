# === 執行模式 ===
# trade  = 完整自動交易 (需 API key + CA 憑證)
# watch  = 看盤模式 (需 API key 接行情，不啟用 CA、不送單)
# report = 報表模式 (不需 API key，使用 TWSE 公開延遲資料)
RUN_MODE=trade

# 行情來源 (留空自動判斷: trade/watch → shioaji, report → twse_public)
# MARKET_SOURCE=shioaji

# 公開延遲資料輪詢間隔 (秒，僅 report 模式)
REPORT_POLL_SECONDS=5

# 報表輸出目錄
REPORT_OUTPUT_DIR=data/reports

# === Shioaji 登入資訊 (trade/watch 模式必填) ===
API_KEY=YOUR_API_KEY
SECRET_KEY=YOUR_SECRET_KEY

# === 電子憑證 (trade 模式實單必填) ===
CA_PATH=C:/path/to/Sinopac.pfx
CA_PASSWORD=your_ca_password
PERSON_ID=A123456789

# === 模擬模式 (true = 不會真的下單，僅 trade 模式有效) ===
SIMULATION=true

# === 監控股票列表 (逗號分隔) ===
SYMBOLS=2330,0050

# === 策略時間 (HH:MM) ===
ENTER_CUTOFF_TIME=09:30
EXIT_TIME=13:15

# === 停損停利 (百分比) ===
STOP_LOSS_PCT=-3.0
TAKE_PROFIT_PCT=6.0
TRAILING_STOP_PCT=2.0

# === 資金控管 ===
MAX_FUND=500000
MAX_LOT_PER_SYMBOL=2

# === Telegram 通知 (留空則不啟用) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
