# === 執行模式 ===
# trade  = 完整自動交易 (已封存，需 DAY_TRADING_UNFREEZE=true)
# watch  = 看盤模式 (需 API key 接行情，不啟用 CA、不送單) ← 預設
# report = 報表模式 (不需 API key，使用 TWSE 公開延遲資料)
RUN_MODE=watch

# === 當沖封存 (2026-06-11 起) ===
# DAY_TRADING_ARCHIVED=true
# DAY_TRADING_UNFREEZE=false   # 僅維護/回歸測試時設 true 以恢復 RUN_MODE=trade

# 行情來源 (留空自動判斷: trade/watch → shioaji, report → twse_public)
# MARKET_SOURCE=shioaji

# broker backend（主程式僅支援 shioaji）
BROKER_BACKEND=shioaji

# 公開延遲資料輪詢間隔 (秒，僅 report 模式)
REPORT_POLL_SECONDS=5

# 報表輸出目錄
REPORT_OUTPUT_DIR=data/reports

# === Shioaji 登入資訊 (trade/watch 模式必填) ===
API_KEY=YOUR_API_KEY
SECRET_KEY=YOUR_SECRET_KEY

# === 電子憑證 (trade 模式實單必填) ===
CA_PATH=C:/path/to/Sinopac.pfx
CA_PASSWORD=your_ca_password
PERSON_ID=YOUR_PERSON_ID

# === 模擬模式 (true = 不會真的下單，僅 trade 模式有效) ===
SIMULATION=true

# === 監控股票列表 (逗號分隔) ===
SYMBOLS=2330,0050
# 四源關注自動合併：昨日/今日戰情室 + 昨日明日關注 + 開盤即時調查
SYMBOLS_AUTO_MERGE=true
SYMBOLS_MERGE_TOP_N=10
SYMBOLS_MERGE_MAX_TOTAL=24
SYMBOLS_MERGE_REFRESH_MIN=10
SYMBOLS_MERGE_BUDGET_FILTER=true

# === 策略時間 (HH:MM) ===
ENTER_CUTOFF_TIME=09:30
EXIT_TIME=13:15
# 午盤獲利平倉：12:50 起淨利>0 即賣，EXIT_TIME 強制清倉（例 10 分鐘窗口）
# PROFIT_EXIT_START_TIME=12:50
# EXIT_TIME=13:00

# === 停損停利 (百分比) ===
STOP_LOSS_PCT=-3.0
TAKE_PROFIT_PCT=6.0
TRAILING_STOP_PCT=2.0
# 每檔使用者指定賣出門檻；例 2330 報酬率達 +8%、0050 達 +5.5% 才允許 AI 自動賣。
# 有設定的股票會優先照此門檻直接賣出，且未達門檻時不會被停損/移動停利/收盤全出自動賣掉。
# 空白 = 該檔沿用原本 STOP_LOSS/TAKE_PROFIT/TRAILING_STOP 邏輯。
SELL_PROFIT_TARGETS=

# === 資金控管 ===
MAX_FUND=500000
# 每日持股預算 (元)；>0 時覆寫 MAX_FUND，例小額每日 1 萬：
# DAILY_FUND_BUDGET=10000
MAX_LOT_PER_SYMBOL=2

# === 進階風控 (0 或空白 = 不限；詳見 README「資金/風險控制」) ===
# PER_ORDER_MAX_COST_TWD=100000
# MAX_OPEN_POSITIONS=5
# DAILY_MAX_ORDERS=20
# PER_SYMBOL_DAILY_MAX_ORDERS=3
# （回落買回 rebuy 不受此限制）
# REENTRY_COOLDOWN_SECONDS=300
# MAX_PCT_CHG_ON_ENTRY=7.0
# MIN_PRICE=10
# MAX_PRICE=2000
# BLACKLIST_SYMBOLS=
# 手動長期持股（永不自動監控/交易，併入黑名單）
# MANUAL_HOLD_SYMBOLS=
# DAILY_MAX_LOSS_TWD=50000
# DAILY_MAX_LOSS_PCT=2.0
# 下單前檢查券商 account_balance（讀不到則拒絕進場）
# CHECK_ACCOUNT_BALANCE=true

# === 做多當沖規則 (STRATEGY_TYPE=configurable) ===
# ALLOW_SAME_DAY_REENTRY=true
# REBUY_TARGET_NET_PCT=2.0
# BROKER_FEE_DISCOUNT=0.28
# BROKER_MIN_FEE=1
# DAY_TRADE_TAX_RATE=0.0015

# === 可設定進場範圍 (STRATEGY_TYPE=configurable) ===
# MIN_PCT_CHG_ON_ENTRY=1.0   # 含邊界：漲 1.0% 即符合進場下限
# MAX_PCT_CHG_ON_ENTRY=5.0
# BUY_ENTRY_TARGETS=2330:1:5,0050:0.5:3

# === 零股 / 小額資金 (1 萬元建議開啟) ===
# USE_ODD_LOT=true
# ODD_LOT_MAX_SHARES=999

# === LLM 進出場閘門 ===
# LLM_GATE_ENABLED=false
# LLM_MIN_SENTIMENT_SCORE=0.2
# LLM_MIN_DAY_TRADE_SCORE=62
# LLM_EXIT_ON_NEGATIVE=false
# LLM_REFRESH_ON_ENTRY=false
# 賣出前須通過 AI 分析才送單 (建議搭配 STRATEGY_TYPE=configurable)
# LLM_SELL_GATE_ENABLED=false
# LLM_SELL_GATE_BYPASS_STOP_LOSS=true
# LLM_SELL_GATE_BYPASS_CLOSE=true
# LLM_SELL_GATE_BYPASS_AFTERNOON=true
# LLM_REFRESH_ON_EXIT=true
# LLM_SELL_MIN_CONFIDENCE=0.5
# 盤中定時 + 成交後刷新 LLM 並產出 intraday_live_review（需 GEMINI_API_KEY）
# LLM_INTRADAY_REVIEW_ENABLED=false
# LLM_INTRADAY_REVIEW_INTERVAL_MIN=60
# LLM_INTRADAY_REVIEW_INTERVAL_FLAT_MIN=10

# === 策略類型 / ETF 跟單 ===
# STRATEGY_TYPE=configurable   # 預設；舊值 default 會自動對應
# STRATEGY_TYPE=etf_follow
# STRATEGY_TYPE=smile_curve    # 微笑曲線（回測：stock-smile-backtest）

# === 微笑曲線策略 (stock-smile-backtest) ===
# SMILE_BUY_TIERS=1:1,3:2,5:3,8:4   # 跌幅%:加碼倍數
# SMILE_BASE_LOT=1
# SMILE_REGULAR_TAX_RATE=0.003       # 一般證交稅（非當沖 0.3%）
# SMILE_REFERENCE_PRICES=2330:580    # 可選固定標準價；留空則每週期以當下價重設
# ETF_MIN_CONSENSUS_NEW=2
# ETF_MIN_CONSENSUS_ADD=3
# ETF_MAX_PCT_CHG_ON_ENTRY=4.0

# === 自動化研究管線預設 ===
# PIPELINE_CHIP_LOOKBACK_DAYS=5
# PIPELINE_MIN_CONSENSUS=2
# PIPELINE_FETCH_ETF=true
# PIPELINE_FETCH_CHIPS=true
# PIPELINE_GENERATE_BRIEF=true
# PIPELINE_FETCH_MACRO=true
# PIPELINE_GENERATE_US_BRIEF=true

# === Telegram 通知 (留空則不啟用) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Gemini LLM 分析 ===
# 到 Google AI Studio 取得 API key: https://aistudio.google.com
# 測試流程：uv run stock-gemini-test
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 僅在無 research_ticker prompt 時允許退回舊版 analyze_presentation（預設關閉）
AUTO_LLM_ALLOW_LEGACY=false

# === 背景排程器 (stock-scheduler) ===
# 讓資料更新 + 盤中監測「持續自動執行」，不必開著儀表板。
#   uv run stock-scheduler            # 常駐 (Ctrl+C 結束)
#   uv run stock-scheduler --once     # 跑一輪即結束 (可搭配 Windows 工作排程器)
#   uv run stock-scheduler --dry-run  # 只印計畫不執行
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=30
# 輕量行情/總經刷新間隔 (分鐘，不打 LLM，成本低)；<=0 停用
SCHEDULER_MACRO_INTERVAL_MIN=30
SCHEDULER_FUNDAMENTALS_INTERVAL_MIN=360
SCHEDULER_FUNDAMENTALS_ARGS=--limit 3 --stale-days 30 --delay-seconds 30
# 完整研究管線間隔 (分鐘，含 ETF/籌碼/基本面 + LLM 簡報，較耗時/費用)；<=0 停用
SCHEDULER_RESEARCH_INTERVAL_MIN=240
# 傳給 stock-auto-research 的額外參數 (例如 "--no-brief" 省 LLM 成本)
SCHEDULER_RESEARCH_ARGS=
# One-shot LLM reports (off by default; dashboard quick start can enable per session)
SCHEDULER_INTRADAY_ENABLED=false
SCHEDULER_INTRADAY_TIME=08:30
SCHEDULER_INTRADAY_END_TIME=14:30
SCHEDULER_NEXTDAY_DRAFT_ENABLED=false
SCHEDULER_NEXTDAY_DRAFT_TIME=14:00
SCHEDULER_NEXTDAY_DRAFT_END_TIME=18:00
SCHEDULER_NEXTDAY_UPDATE_ENABLED=false
SCHEDULER_NEXTDAY_UPDATE_TIME=02:00
SCHEDULER_NEXTDAY_UPDATE_END_TIME=06:00
# 公司基本資料 (名稱/產業/上市日) 補齊間隔 (分鐘)；靜態資料預設一天一次；<=0 停用
SCHEDULER_COMPANY_INTERVAL_MIN=1440
# Google Sheets 自動同步間隔 (分鐘，含 LLM 分析表)；<=0 停用
# 手動同步：uv run stock-cloud-sync（見 docs/cloud_sync_setup.md）
SCHEDULER_CLOUD_SYNC_INTERVAL_MIN=0
# 慢速補齊歷史日 K (TWSE 月別，避免 403)；<=0 停用
# 手動：uv run stock-history-fetch --init --start 2020-01-01
# 常駐：uv run stock-history-fetch --daemon --batch-size 1 --sleep 120
SCHEDULER_HISTORY_FETCH_INTERVAL_MIN=60
SCHEDULER_HISTORY_FETCH_ARGS=--once --batch-size 5 --delay 5
SCHEDULER_HISTORY_FETCH_TIME=14:00
SCHEDULER_HISTORY_FETCH_END_TIME=23:00

# === 事件鏈 (Pub/Sub 下游自動觸發) ===
# true：stock-watch-data-fetch 完成後自動跑微笑曲線選股
# EVENT_CHAIN_SMILE_SCREEN=false
# 基本面慢速刷新：uv run stock-fundamentals-refresh
# true = 資料刷新只在台股交易時段 (08:30-14:30) 與平日執行
SCHEDULER_MARKET_HOURS_ONLY=true
SCHEDULER_RUN_ON_START=true
# 盤中自動托管 stock-bot 監測子行程 (開盤啟動、收盤停止)
SCHEDULER_SUPERVISE_MONITOR=false
SCHEDULER_MONITOR_MODE=watch
# 只看不買：約 10 元熱度 + 熱門個股期貨快照 (分鐘)；<=0 停用
SCHEDULER_WATCH_SNAPSHOT_INTERVAL_MIN=0

# === 只看不買範本 ===
# 複製 .env.watch-only.example 或直接參考下列關鍵項：
# RUN_MODE=watch | DAY_TRADING_ARCHIVED=true | SCHEDULER_MONITOR_MODE=watch
# SYMBOLS_AUTO_MERGE=false | SCHEDULER_INTRADAY_ENABLED=false
# uv run stock-watch-snapshot  # 手動快照
# .\scripts\start-watch-only.ps1

# === 本地股票資料庫 (SQLite) ===
# 留空 = 預設 data/stock.db
# 若想用「Google 雲端硬碟同步」單機共用，把它指到 Drive 同步資料夾：
#   STOCK_DB_PATH=G:/My Drive/stock-shared/stock.db
STOCK_DB_PATH=

# 全球科技事件行事曆快取有效期 (小時，預設 12)
GLOBAL_EVENTS_MAX_AGE_HOURS=12

# === 雲端同步 (Google Sheets，多機共用 / Forms 寫入) ===
# 1. 在 Google Cloud Console 建立 service account 並啟用 Sheets + Drive API
# 2. 下載 SA 金鑰 JSON 並把路徑填到 GOOGLE_SA_JSON_PATH
# 3. 開一張 Google Sheet，把 SA 的 email 加為「編輯者」
# 4. 把 Sheet URL 中 /d/ 後的隨機 ID 填到 GOOGLE_SHEET_ID
# 詳細步驟請見 docs/cloud_sync_setup.md
GOOGLE_SHEET_ID=
GOOGLE_SA_JSON_PATH=

# Optional: Google Drive Desktop/shared folder used as a cross-machine cache.
# The app mirrors fetched files under data/ here, and another machine restores
# them before hitting TWSE/MOPS/yfinance/Gemini again.
# Example: G:/My Drive/stock-cloud-cache
GOOGLE_CACHE_DIR=
